# Smart Library - Environment Variables
# Copy this file to .env and fill in your values

# Flask
SECRET_KEY=change-this-to-a-random-secret-key-in-production
DEBUG=True

# Database (MySQL)
DATABASE_URL=mysql+pymysql://root:your_password@localhost/smart_library

# JWT
JWT_SECRET_KEY=change-this-jwt-secret-too

# Mail (optional - for email notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_DEFAULT_SENDER=library@university.edu
